{
  "manifest_version": 3,
  "name": "Password Caliper",
  "version": "1.0.0",
  "description": "Hover any password field to see a caliper measure the real width hidden behind the dots.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["caliper-widget.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
